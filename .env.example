# Copia este archivo como .env.local y llena los valores reales.
# NUNCA subas .env.local a git.

# --- Supabase (Settings → API en el dashboard de Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role-secreta

# --- Meta / Facebook (Sprint 3) ---
# META_PAGE_ACCESS_TOKEN=
# META_PAGE_ID=

# --- WhatsApp Cloud API (Sprint 4) ---
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=

# --- IA conversacional (Sprint 4) ---
# Gemini (Google AI Studio, plan gratuito): https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest   # opcional, este es el valor por defecto
